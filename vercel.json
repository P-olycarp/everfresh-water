{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "api/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": "backend"
    },
    {
      "source": "/(.*)",
      "destination": "frontend"
    }
  ]
}
